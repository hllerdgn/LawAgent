# LawAgent AI — Ortam Değişkenleri Şablonu
# Bu dosyayı kopyalayıp .env olarak kaydedin ve değerleri doldurun.
# Gerçek .env dosyasını kesinlikle Git'e commit etmeyin!

# ── LLM (Groq) ────────────────────────────────────────────────────────────────
GROQ_API_KEY=gsk_...                         # Zorunlu
GROQ_MODEL=llama-3.3-70b-versatile          # Opsiyonel — varsayılan: llama-3.3-70b-versatile

# ── Qdrant Vektör Veritabanı ──────────────────────────────────────────────────
QDRANT_URL=https://...qdrant.io:6333        # Cloud için — boşsa localhost fallback
QDRANT_API_KEY=eyJ...                        # Cloud için

# ── Güvenlik ─────────────────────────────────────────────────────────────────
ADMIN_API_KEY=your-strong-random-secret      # Admin endpoint'leri için zorunlu (prod'da)

# ── CORS ─────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=https://yourdomain.com,http://localhost:5173

# ── Monitoring ───────────────────────────────────────────────────────────────
SENTRY_DSN=https://...@ingest.sentry.io/... # Opsiyonel

# ── Sunucu ───────────────────────────────────────────────────────────────────
PORT=7860
ENV=production
