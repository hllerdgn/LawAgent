# ════════════════════════════════════════════════════════
# LawAgent AI — Ortam Değişkenleri Şablonu
# ════════════════════════════════════════════════════════
# Bu dosyayı kopyalayarak .env oluşturun:
#   cp .env.example .env
# Ardından gerçek değerleri doldurun.
# .env dosyasını ASLA git'e yüklemeyin!
# ════════════════════════════════════════════════════════

# ── Groq API (LLM) ───────────────────────────────────────
# https://console.groq.com adresinden ücretsiz alabilirsiniz
GROQ_API_KEY=your_groq_api_key_here

# ── Qdrant Ayarları ───────────────────────────────────────
# Local çalışma için (Docker ile Qdrant kullanıyorsanız):
QDRANT_URL=http://localhost:6333
# Local path ile (Docker olmadan):
# QDRANT_STORAGE=./src/data/qdrant_storage

# ── Ortam ─────────────────────────────────────────────────
# development | production
ENV=development

# ── Ngrok (isteğe bağlı, Colab tüneli için) ──────────────
# https://dashboard.ngrok.com adresinden alabilirsiniz
NGROK_AUTH_TOKEN=your_ngrok_token_here

# ── CORS Ayarları ─────────────────────────────────────────
# Boş bırakılırsa tüm originlere izin verilir (["*"])
# Production'da Vercel domain'inizi buraya ekleyin:
# ALLOWED_ORIGINS=https://your-frontend.vercel.app,http://localhost:5173
ALLOWED_ORIGINS=

# ── Frontend URL (dokümantasyon amaçlı) ──────────────────
# Vercel'de deploy edilen frontend URL'si
FRONTEND_URL=https://your-frontend.vercel.app
